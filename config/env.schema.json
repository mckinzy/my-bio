{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Environment Variables",
  "type": "object",
  "properties": {
    "PROFILE_SITE_ENV": {
      "type": "string",
      "enum": ["development", "production"]
    },
    "SITE_TITLE": {
      "type": "string"
    },
    "ANALYTICS_ID": {
      "type": ["string", "null"]
    },
    "DATABASE_URL": {
      "type": "string"
    },
    "DATABASE_MAX_CONNECTIONS": {
      "type": "integer",
      "minimum": 1
    }
  },
  "required": ["PROFILE_SITE_ENV", "DATABASE_URL"],
  "additionalProperties": false
}
